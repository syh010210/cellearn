            { "val": "UPPER(대문자)", "editable": false },
            { "val": "LOWER(소문자)", "editable": false }
          ],
          [
            { "val": "Hello World", "editable": false },
            { "val": "", "editable": true, "answer": "=LEN(A2)", "result": 11 },
            { "val": "", "editable": true, "answer": "=UPPER(A2)", "result": "HELLO WORLD" },
            { "val": "", "editable": true, "answer": "=LOWER(A2)", "result": "hello world" }
          ]
        ]
      }
