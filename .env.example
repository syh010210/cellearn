# Supabase — 프로젝트 생성 후 Settings > API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 포트원(PortOne) — 결제창 호출에 쓰는 공개 식별자(브라우저 노출 OK)
VITE_PORTONE_STORE_ID=store-xxxxxxxx
VITE_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx

# ── 아래는 서버(Supabase Edge Function)에서만 쓰는 비밀값 ──
# 절대 VITE_ 접두사를 붙이지 말 것(붙이면 브라우저에 노출됨).
# Supabase 대시보드 > Edge Functions > Secrets 에 등록한다.
# PORTONE_API_SECRET=...
# SUPABASE_SERVICE_ROLE_KEY=...
